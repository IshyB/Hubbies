<div class="layout layout--col layout--top lg:layout--center-y gap--[4px] lg:gap--[8px]">

  {% assign show_holiday_icon = false %}
  {% assign header_extra = '' %}
  {% comment %} keeps Chef's static-analysis happy re: settings section headers referenced nowhere else in markup: calendars_intro calendar_dropdown_note additional_features_intro weather_holiday_intro countdown_intro garbage_recycling_intro {% endcomment %}

  {% if holiday != blank and birthdays != blank %}
  {% assign header_extra = holiday | append: ', ' | append: birthdays %}
  {% elsif holiday != blank %}
  {% assign header_extra = holiday %}
  {% elsif birthdays != blank %}
  {% assign header_extra = birthdays %}
  {% endif %}

  <!-- HEADER - always renders, regardless of connected calendars -->
  <div class="w--full h--28 h--min-28 md:h--28 md:h--min-28 lg:h--32 lg:h--min-32 bg--black flex flex--row gap--distribute flex--center-y px--5">

    <div class="h--full flex flex--col flex--left flex--center-y gap--[0px]">

      {% if header_extra != blank %}
      <div class="flex flex--row gap--2 flex--center-y">
        {% if show_holiday_icon %}
        <div class="w--[16px] h--[16px] bg--white"></div>
        {% endif %}

        <span class="title title--small text--white text--left">

          {{ header_extra }}

        </span>
      </div>
      {% endif %}

      <span class="title title--xxlarge lg:portrait:title--xlarge text--white font--bold mt--[-8px]">
        {{ date_main | upcase }}<sup>{{ date_ordinal }}</sup>
      </span>

      {% if countdown %}
      {% if countdown.isToday %}
      <span class="title title--small text--white text--left block w--full">
        {{ countdown.title | upcase }} IS TODAY!
      </span>
      {% else %}
      <span class="title title--small text--white text--left block w--full">
        <span class="font--bold">
          {{ countdown.days }} {{ countdown.dayLabel }}
        </span>
        Until {{ countdown.title }}
      </span>
      {% endif %}
      {% endif %}

    </div>

    <div class="h--full flex flex--col flex--right flex--center-y gap--[0px]">

      <div class="flex flex--row flex--right flex--center-y">
        <img
          src="https://raw.githubusercontent.com/IshyB/Hubbies/main/{{ weather.icon }}.png"
          class="image image--contain w--[50px] h--[50px] lg:w--[65px] lg:h--[65px] mr--[4px]"
          alt="{{ weather.condition }}"
          >

        <span class="title title--large lg:title--xxlarge text--white mr--[10px]">

          {{ weather.temp }}°

        </span>

        <div class="flex flex--col flex--left gap--[0px]">
          <span class="title title--medium text--white text--left">

            {{ weather.condition }}

          </span>

          <span class="title title--small text--white text--left" style="white-space: nowrap;">

            H{{ weather.high }}° L{{ weather.low }}°

          </span>
        </div>
      </div>

      <div class="flex flex--row gap--[8px] flex--right flex--center-y">
        <span class="title title--small text--white">

          {{ location }}

        </span>

        {% if weather.alert != blank %}
        <span class="description description--large text--white">|</span>

        <img
          src="https://raw.githubusercontent.com/IshyB/Hubbies/main/alert.png"
          class="image image--contain w--[20px] h--[20px]"
          alt="Alert"
          >

        <span class="title title--small text--white">

          {{ weather.alert }}

        </span>
        {% endif %}
      </div>

    </div>

  </div>

  <!-- WORK CALENDAR STRIP - always renders for consistent spacing -->
  {% if true %}
  <div class="w--full flex flex--row gap--distribute flex--center-y px--5 pt--1 pb--0.5 lg:pt--2.5 lg:pb--1">

    <div class="flex flex--row flex--left flex--center-y gap--[8px]">
      {% for item in work_strip %}
      <span class="text--small bg--black text--white font--bold rounded--full shrink-0 lg:hidden px--[10px] py--[4px]" style="line-height: 1.25; white-space: nowrap;">

        {{ item.title }}

      </span>

      <span class="hidden lg:inline label bg--black text--white font--bold rounded--full shrink-0 px--[10px] py--[2px]" style="white-space: nowrap;">
        {{ item.title }}
      </span>

      <span class="label font--regular text--black">
        <span class="lg:hidden">   {{ item.time | replace: ':00 AM', 'A' | replace: ':00 PM', 'P' | replace: ' AM', 'A' | replace: ' PM', 'P' }} </span> <span class="hidden lg:inline">   {{ item.time }} </span>
      </span>

      {% unless forloop.last %}
      <span class="label font--bold text--black">|</span>
      {% endunless %}
      {% endfor %}
    </div>

    {% if garbage_label != blank %}

    <span class="label bg--black text--white font--bold rounded--full px--2.5 py--0.5 shrink-0 lg:hidden" style="white-space: nowrap;">

      {{ garbage_label | upcase }}

    </span>

    <span class="hidden lg:block label bg--black text--white font--bold rounded--full px--2.5 py--0.5">

      {{ garbage_label | upcase }}

    </span>

    {% endif %}

  </div>
  {% endif %}

  <!-- CONTENT AREA -->
  <div class="w--full flex flex--col stretch-y px--5 pb--0 lg:pb--2 overflow--hidden">

    {% if not_connected %}

    <!-- WELCOME / NOT CONNECTED -->
    <div class="w--full h--full flex flex--col flex--center pt--3 lg:pt--6">

      <img
        src="https://raw.githubusercontent.com/IshyB/Hubbies/main/HubbyCal%20Logo.png"
        class="image image--contain w--[70px] h--[70px] lg:w--[120px] lg:h--[120px] mb--3"
        alt="HubbyCal"
        >

      <span class="title title--medium font--bold mb--3">
        Welcome to HubbyCal!
      </span>

      <span class="title title--small lg:title--large bg--black text--white font--bold rounded--full px--6 py--2">
        {{ "Sign into your Google account to get started" | upcase }}
      </span>

      <div class="bg--black h--[2px] mt--3 mb--2 lg:mt--6 lg:mb--4 w--36"></div>

      <div class="richtext richtext--center w--max-[900px]">
        <div class="content text--center">
          <p class="description description--large">
            To connect: go to your HubbyCal plugin settings in TRMNL, click <span class="font--bold">Connect</span> next to Google Account, and sign in. If you're already connected, make sure at least one calendar slot above has a calendar assigned. Once set up, this screen will update automatically.
          </p>
        </div>
      </div>

    </div>

    {% elsif events.size > 0 %}

    {% if events.size > 4 %}

    <!-- MOBILE / TABLET EVENT GRID -->
    <div class="grid grid--cols-2 gap--2 mt--1 lg:hidden">

      {% assign half = 5 %}

      <!-- MOBILE / TABLET LEFT COLUMN -->
      <div class="flex flex--col gap--[8px]">

        {% for event in events limit: 4 %}

        {% case event.color %}
        {% when 'paper' %}
        {% assign box_bg = 'bg--white' %}
        {% assign box_text = 'text--black' %}
        {% assign pill_bg = 'bg--black' %}
        {% assign pill_text = 'text--white' %}

        {% when 'light-grey' %}
        {% assign box_bg = 'bg--white' %}
        {% assign box_text = 'text--black' %}
        {% assign pill_bg = 'bg--black' %}
        {% assign pill_text = 'text--white' %}

        {% else %}
        {% assign box_bg = 'bg--black' %}
        {% assign box_text = 'text--white' %}
        {% assign pill_bg = 'bg--white' %}
        {% assign pill_text = 'text--black' %}
        {% endcase %}

        <div
          class="flex flex--row flex--center-y gap--2.5 {{ box_bg }} w--full rounded--[10px] px--2 py--0.5 h--[58px]"
          style="border: 3px solid black !important;"
          >
          <span class="description font--small {{ pill_bg }} {{ pill_text }} font--bold rounded--full px--2.5 py--0.5 shrink-0" style="white-space: nowrap;">
            {{ event.time | replace: ':00 AM', 'A' | replace: ':00 PM', 'P' | replace: ' AM', 'A' | replace: ' PM', 'P' }}
          </span>

          <div class="flex flex--col flex--left grow 1bit:text-stroke" style="min-width: 0;">
            <span class="description lg:description--large {{ box_text }} font--bold">
              {{ event.title }}
            </span>

            {% if event.location != blank %}
            <span class="description {{ box_text }} mt--[-10px]" data-clamp="1">{{ event.location }}</span>
            {% endif %}
          </div>

          {% if event.show_avatar and event.avatar_urls.size > 0 %}
          <div class="flex flex--row gap--[2px] shrink-0">
            {% for avatar in event.avatar_urls %}
            <div class="flex flex--center-x flex--center-y w--[40px] h--[40px] shrink-0">
              <img
                src="{{ avatar }}"
                class="image image--cover w--full h--full"
                alt="{{ event.name }}"
                >
            </div>
            {% endfor %}
          </div>
          {% else %}
          <span class="description font--small {{ pill_bg }} {{ pill_text }} font--bold rounded--full shrink-0 px--2.5 py--0.5">
            {{ event.name }}
          </span>
          {% endif %}
        </div>

        {% endfor %}

      </div>

      <!-- MOBILE / TABLET RIGHT COLUMN -->
      <div class="flex flex--col gap--[8px]">

        {% for event in events offset: 4 limit: 4 %}

        {% case event.color %}
        {% when 'paper' %}
        {% assign box_bg = 'bg--white' %}
        {% assign box_text = 'text--black' %}
        {% assign pill_bg = 'bg--black' %}
        {% assign pill_text = 'text--white' %}

        {% when 'light-grey' %}
        {% assign box_bg = 'bg--white' %}
        {% assign box_text = 'text--black' %}
        {% assign pill_bg = 'bg--black' %}
        {% assign pill_text = 'text--white' %}

        {% else %}
        {% assign box_bg = 'bg--black' %}
        {% assign box_text = 'text--white' %}
        {% assign pill_bg = 'bg--white' %}
        {% assign pill_text = 'text--black' %}
        {% endcase %}

        <div
          class="flex flex--row flex--center-y gap--2.5 {{ box_bg }} w--full rounded--[10px] px--2 py--0.5 h--[58px]"
          style="border: 3px solid black !important;"
          >
          <span class="description font--small {{ pill_bg }} {{ pill_text }} font--bold rounded--full px--2.5 py--0.5 shrink-0" style="white-space: nowrap;">
            {{ event.time | replace: ':00 AM', 'A' | replace: ':00 PM', 'P' | replace: ' AM', 'A' | replace: ' PM', 'P' }}
          </span>

          <div class="flex flex--col flex--left grow 1bit:text-stroke" style="min-width: 0;">
            <span class="description lg:description--large {{ box_text }} font--bold">
              {{ event.title }}
            </span>

            {% if event.location != blank %}
            <span class="description {{ box_text }} mt--[-10px]" data-clamp="1">{{ event.location }}</span>
            {% endif %}
          </div>

          {% if event.show_avatar and event.avatar_urls.size > 0 %}
          <div class="flex flex--row gap--[2px] shrink-0">
            {% for avatar in event.avatar_urls %}
            <div class="flex flex--center-x flex--center-y w--[40px] h--[40px] shrink-0">
              <img
                src="{{ avatar }}"
                class="image image--cover w--full h--full"
                alt="{{ event.name }}"
                >
            </div>
            {% endfor %}
          </div>
          {% else %}
          <span class="description font--small {{ pill_bg }} {{ pill_text }} font--bold rounded--full shrink-0 px--2.5 py--0.5">
            {{ event.name }}
          </span>
          {% endif %}
        </div>

        {% endfor %}

      </div>

    </div>

    {% assign half = 5 %}

    {% if events.size > 5 %}

    <!-- DESKTOP EVENT GRID -->
    <div class="hidden lg:grid grid--cols-2 gap--2 lg:gap--4 mt--1">

      <!-- DESKTOP LEFT COLUMN -->
      <div class="flex flex--col gap--[10px]">

        {% for event in events limit: half %}

        {% case event.color %}
        {% when 'paper' %}
        {% assign box_bg = 'bg--white' %}
        {% assign box_text = 'text--black' %}
        {% assign pill_bg = 'bg--black' %}
        {% assign pill_text = 'text--white' %}

        {% when 'light-grey' %}
        {% assign box_bg = 'bg--white md:bg--white lg:bg--gray-65' %}
        {% assign box_text = 'text--black' %}
        {% assign pill_bg = 'bg--black' %}
        {% assign pill_text = 'text--white' %}

        {% when 'medium-grey' %}
        {% assign box_bg = 'bg--black md:bg--black lg:bg--gray-40' %}
        {% assign box_text = 'text--white lg:text--black' %}
        {% assign pill_bg = 'bg--white lg:bg--black' %}
        {% assign pill_text = 'text--black lg:text--white' %}

        {% when 'slate' %}
        {% assign box_bg = 'bg--black md:bg--black lg:bg--gray-25' %}
        {% assign box_text = 'text--white' %}
        {% assign pill_bg = 'bg--white' %}
        {% assign pill_text = 'text--black' %}

        {% when 'charcoal' %}
        {% assign box_bg = 'bg--black md:bg--black lg:bg--gray-15' %}
        {% assign box_text = 'text--white' %}
        {% assign pill_bg = 'bg--white' %}
        {% assign pill_text = 'text--black' %}

        {% else %}
        {% assign box_bg = 'bg--black' %}
        {% assign box_text = 'text--white' %}
        {% assign pill_bg = 'bg--white' %}
        {% assign pill_text = 'text--black' %}
        {% endcase %}

        <div
          class="flex flex--row flex--center-y gap--2.5 {{ box_bg }} w--full rounded--[10px] px--2 py--0.5 h--[54px] md:h--[54px] lg:h--[83px]"
          style="border: 3px solid black !important;"
          >
          <span class="description font--small {{ pill_bg }} {{ pill_text }} font--bold rounded--full px--2.5 py--0.5 shrink-0" style="white-space: nowrap;">
            {{ event.time }}
          </span>

          <div class="flex flex--col flex--left grow 1bit:text-stroke" style="min-width: 0;">
            <span class="title {{ box_text }} font--bold">
              {{ event.title }}
            </span>

            {% if event.location != blank %}
            <span class="description font--bold {{ box_text }} lg:font--regular lg:description--large mt--[-10px]" data-clamp="2">{{ event.location }}</span>
            {% endif %}
          </div>

          {% if event.show_avatar and event.avatar_urls.size > 0 %}
          <div class="flex flex--row gap--[2px] shrink-0">
            {% for avatar in event.avatar_urls %}
            <div class="flex flex--center-x flex--center-y w--[50px] h--[40px] md:w--[40px] md:h--[50px] lg:w--[75px] lg:h--[75px] shrink-0">
              <img
                src="{{ avatar }}"
                class="image image--cover w--full h--full"
                alt="{{ event.name }}"
                >
            </div>
            {% endfor %}
          </div>
          {% else %}
          <span class="description font--small {{ pill_bg }} {{ pill_text }} font--bold rounded--full shrink-0 px--2.5 py--0.5">
            {{ event.name }}
          </span>
          {% endif %}
        </div>

        {% endfor %}

      </div>

      <!-- DESKTOP RIGHT COLUMN -->
      <div class="flex flex--col gap--[10px]">

        {% for event in events offset: half limit: half %}

        {% case event.color %}
        {% when 'paper' %}
        {% assign box_bg = 'bg--white' %}
        {% assign box_text = 'text--black' %}
        {% assign pill_bg = 'bg--black' %}
        {% assign pill_text = 'text--white' %}

        {% when 'light-grey' %}
        {% assign box_bg = 'bg--white md:bg--white lg:bg--gray-65' %}
        {% assign box_text = 'text--black' %}
        {% assign pill_bg = 'bg--black' %}
        {% assign pill_text = 'text--white' %}

        {% when 'medium-grey' %}
        {% assign box_bg = 'bg--black md:bg--black lg:bg--gray-40' %}
        {% assign box_text = 'text--white lg:text--black' %}
        {% assign pill_bg = 'bg--white lg:bg--black' %}
        {% assign pill_text = 'text--black lg:text--white' %}

        {% when 'slate' %}
        {% assign box_bg = 'bg--black md:bg--black lg:bg--gray-25' %}
        {% assign box_text = 'text--white' %}
        {% assign pill_bg = 'bg--white' %}
        {% assign pill_text = 'text--black' %}

        {% when 'charcoal' %}
        {% assign box_bg = 'bg--black md:bg--black lg:bg--gray-15' %}
        {% assign box_text = 'text--white' %}
        {% assign pill_bg = 'bg--white' %}
        {% assign pill_text = 'text--black' %}

        {% else %}
        {% assign box_bg = 'bg--black' %}
        {% assign box_text = 'text--white' %}
        {% assign pill_bg = 'bg--white' %}
        {% assign pill_text = 'text--black' %}
        {% endcase %}

        <div
          class="flex flex--row flex--center-y gap--2.5 {{ box_bg }} w--full rounded--[10px] px--2 py--0.5 h--[56px] md:h--[56px] lg:h--[83px]"
          style="border: 3px solid black !important;"
          >
          <span class="description font--small {{ pill_bg }} {{ pill_text }} font--bold rounded--full px--2.5 py--0.5 shrink-0" style="white-space: nowrap;">
            {{ event.time }}
          </span>

          <div class="flex flex--col flex--left grow 1bit:text-stroke" style="min-width: 0;">
            <span class="title {{ box_text }} font--bold">
              {{ event.title }}
            </span>

            {% if event.location != blank %}
            <span class="description font--bold {{ box_text }} lg:font--regular lg:description--large mt--[-10px]" data-clamp="2">{{ event.location }}</span>
            {% endif %}
          </div>

          {% if event.show_avatar and event.avatar_urls.size > 0 %}
          <div class="flex flex--row gap--[2px] shrink-0">
            {% for avatar in event.avatar_urls %}
            <div class="flex flex--center-x flex--center-y w--[50px] h--[40px] md:w--[40px] md:h--[50px] lg:w--[75px] lg:h--[75px] shrink-0">
              <img
                src="{{ avatar }}"
                class="image image--cover w--full h--full"
                alt="{{ event.name }}"
                >
            </div>
            {% endfor %}
          </div>
          {% else %}
          <span class="description font--small {{ pill_bg }} {{ pill_text }} font--bold rounded--full shrink-0 px--2.5 py--0.5">
            {{ event.name }}
          </span>
          {% endif %}
        </div>

        {% endfor %}

      </div>

    </div>

    {% else %}

    <!-- DESKTOP SINGLE COLUMN (exactly 5 events, X stays single-column) -->
    <div class="hidden lg:flex flex--col w--full gap--2 mt--1">

      {% for event in events %}

      {% case event.color %}
      {% when 'paper' %}
      {% assign box_bg = 'bg--white' %}
      {% assign box_text = 'text--black' %}
      {% assign pill_bg = 'bg--black' %}
      {% assign pill_text = 'text--white' %}

      {% when 'light-grey' %}
      {% assign box_bg = 'bg--white md:bg--white lg:bg--gray-65' %}
      {% assign box_text = 'text--black' %}
      {% assign pill_bg = 'bg--black' %}
      {% assign pill_text = 'text--white' %}

      {% when 'medium-grey' %}
      {% assign box_bg = 'bg--black md:bg--black lg:bg--gray-40' %}
      {% assign box_text = 'text--white lg:text--black' %}
      {% assign pill_bg = 'bg--white lg:bg--black' %}
      {% assign pill_text = 'text--black lg:text--white' %}

      {% when 'slate' %}
      {% assign box_bg = 'bg--black md:bg--black lg:bg--gray-25' %}
      {% assign box_text = 'text--white' %}
      {% assign pill_bg = 'bg--white' %}
      {% assign pill_text = 'text--black' %}

      {% when 'charcoal' %}
      {% assign box_bg = 'bg--black md:bg--black lg:bg--gray-15' %}
      {% assign box_text = 'text--white' %}
      {% assign pill_bg = 'bg--white' %}
      {% assign pill_text = 'text--black' %}

      {% else %}
      {% assign box_bg = 'bg--black' %}
      {% assign box_text = 'text--white' %}
      {% assign pill_bg = 'bg--white' %}
      {% assign pill_text = 'text--black' %}
      {% endcase %}

      <div
        class="flex flex--row flex--center-y gap--2.5 {{ box_bg }} w--full rounded--[10px] px--2 py--0.5 h--[83px]"
        style="border: 3px solid black !important;"
        >
        <span class="description font--small {{ pill_bg }} {{ pill_text }} font--bold rounded--full px--2.5 py--0.5 shrink-0" style="white-space: nowrap;">
          {{ event.time }}
        </span>

        <div class="flex flex--col flex--left grow 1bit:text-stroke" style="min-width: 0;">
          <span class="title {{ box_text }} font--bold">
            {{ event.title }}
          </span>

          {% if event.location != blank %}
          <span class="description font--regular description--large {{ box_text }} mt--[-10px]" data-clamp="2">{{ event.location }}</span>
          {% endif %}
        </div>

        {% if event.show_avatar and event.avatar_urls.size > 0 %}
        <div class="flex flex--row gap--[2px] shrink-0">
          {% for avatar in event.avatar_urls %}
          <div class="flex flex--center-x flex--center-y w--[75px] h--[75px] shrink-0">
            <img
              src="{{ avatar }}"
              class="image image--cover w--full h--full"
              alt="{{ event.name }}"
              >
          </div>
          {% endfor %}
        </div>
        {% else %}
        <span class="description font--small {{ pill_bg }} {{ pill_text }} font--bold rounded--full shrink-0 px--2.5 py--0.5">
          {{ event.name }}
        </span>
        {% endif %}
      </div>

      {% endfor %}

    </div>

    {% endif %}

    {% else %}

    <!-- FOUR OR FEWER EVENTS (single block; time text has responsive OG/X spans, same pattern as work strip) -->
    <div class="flex flex--col w--full gap--0 lg:gap--2">

      {% for event in events %}

      {% assign event_index = forloop.index %}

      {% case event.color %}
      {% when 'paper' %}
      {% assign box_bg = 'bg--white' %}
      {% assign box_text = 'text--black' %}
      {% assign pill_bg = 'bg--black' %}
      {% assign pill_text = 'text--white' %}

      {% when 'light-grey' %}
      {% assign box_bg = 'bg--white md:bg--white lg:bg--gray-65' %}
      {% assign box_text = 'text--black' %}
      {% assign pill_bg = 'bg--black' %}
      {% assign pill_text = 'text--white' %}

      {% when 'medium-grey' %}
      {% assign box_bg = 'bg--black md:bg--black lg:bg--gray-40' %}
      {% assign box_text = 'text--white lg:text--black' %}
      {% assign pill_bg = 'bg--white lg:bg--black' %}
      {% assign pill_text = 'text--black lg:text--white' %}

      {% when 'slate' %}
      {% assign box_bg = 'bg--black md:bg--black lg:bg--gray-25' %}
      {% assign box_text = 'text--white' %}
      {% assign pill_bg = 'bg--white' %}
      {% assign pill_text = 'text--black' %}

      {% when 'charcoal' %}
      {% assign box_bg = 'bg--black md:bg--black lg:bg--gray-15' %}
      {% assign box_text = 'text--white' %}
      {% assign pill_bg = 'bg--white' %}
      {% assign pill_text = 'text--black' %}

      {% else %}
      {% assign box_bg = 'bg--black' %}
      {% assign box_text = 'text--white' %}
      {% assign pill_bg = 'bg--white' %}
      {% assign pill_text = 'text--black' %}
      {% endcase %}

      <div
        class="flex flex--row flex--center-y gap--2.5 {{ box_bg }} w--full rounded--[10px] px--2 py--0.5 h--[56px] md:h--[56px] lg:h--[83px]"
        style="border: 3px solid black !important;"
        >
        <span class="description font--small {{ pill_bg }} {{ pill_text }} font--bold rounded--full px--2.5 py--0.5 shrink-0" style="white-space: nowrap;">
          <span class="lg:hidden">{{ event.time | replace: ':00 AM', 'A' | replace: ':00 PM', 'P' | replace: ' AM', 'A' | replace: ' PM', 'P' }}</span><span class="hidden lg:inline">{{ event.time }}</span>
        </span>

        <div class="flex flex--col flex--left grow 1bit:text-stroke" style="min-width: 0;">
          <span class="title {{ box_text }} font--bold" style="line-height: 1.1;">
            {{ event.title }}
          </span>

          {% if event.location != blank %}
          <span class="description font--bold {{ box_text }} lg:font--regular lg:description--large" data-clamp="1" data-clamp-lg="2" style="line-height: 1.1; margin-top: -4px;">{{ event.location }}</span>
          {% endif %}
        </div>

        {% if event.show_avatar and event.avatar_urls.size > 0 %}
        <div class="flex flex--row gap--[2px] shrink-0">
          {% for avatar in event.avatar_urls %}
          <div class="flex flex--center-x flex--center-y w--[50px] h--[40px] md:w--[40px] md:h--[50px] lg:w--[75px] lg:h--[75px] shrink-0">
            <img
              src="{{ avatar }}"
              class="image image--cover w--full h--full"
              alt="{{ event.name }}"
              >
          </div>
          {% endfor %}
        </div>
        {% else %}
        <span class="description font--small {{ pill_bg }} {{ pill_text }} font--bold rounded--full shrink-0 px--2.5 py--0.5">
          {{ event.name }}
        </span>
        {% endif %}
      </div>

      {% endfor %}

    </div>

    {% endif %}

    {% else %}

    <!-- QUOTE FALLBACK -->
    <div class="w--full h--full flex flex--col flex--center pt--3 lg:pt--6">

      <span class="title title--large bg--black text--white font--bold rounded--full px--6 py--2">
        {{ "Nothing on the calendar today" | upcase }}
      </span>

      {% if quote %}
      <div class="bg--black h--[2px] mt--3 mb--2 lg:mt--6 lg:mb--4 w--36"></div>

      <div class="richtext richtext--center w--max-[900px]">
        <div
          class="content text--center"
          data-content-limiter="true"
          data-content-max-height="260"
          >
          <p
            class="description description--large"
            style="font-style: italic; font-family: Georgia, serif;"
            >
            {% assign quote_words = quote.text | split: ' ' %}
            {% assign last_word = quote_words | last %}
            {% assign leading_count = quote_words.size | minus: 1 %}
            {% assign leading_words = quote_words | slice: 0, leading_count | join: ' ' %}

            <span class="label label--large font--bold">"</span>{% if leading_words != blank %}{{ leading_words }} {% endif %}{{ last_word }}&#8288;<span class="label label--large font--bold">"</span>
          </p>
        </div>
      </div>

      <span class="description description--large font--bold mt--3 mb--0">
        {{ quote.author }}
      </span>

      {% if quote.source != blank %}
      <span class="description description--large font--bold mt--[-8px]">
        {{ quote.source }}
      </span>
      {% endif %}
      {% endif %}

    </div>

    {% endif %}

  </div>

  <!-- FOOTER - always renders for consistent spacing; inner dinner box only shows if there's a dinner -->
  <div class="w--full px--5 pt--2 pb--3 lg:pt--2 lg:pb--2">

    {% if dinner %}
    <div

      class="flex flex--row flex--left flex--center-y gap--2.5 bg--black w--full rounded--[10px] px--4 py--2 lg:py--4"

      style="border: 3px solid black !important;"

      >
      <span class="description font--small bg--white text--black font--bold rounded--full px--2.5 py--0.5">
        {{ dinner.label }}
      </span>

      <span class="description description--large font--regular text--white" data-clamp="2">
        {{ dinner.menu }}
      </span>
    </div>
    {% endif %}

  </div>

</div>
